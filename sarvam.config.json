{
  "version": "3",
  "packages": ["src/lib/ai.ts", "src/lib/repository.ts", "src/lib/score-engine.ts", "src/lib/api-utils.ts"],
  "sarvam": {
    "stt": { "model": "saaras:v3", "endpoint": "/speech-to-text", "batch": "/speech-to-text/batch" },
